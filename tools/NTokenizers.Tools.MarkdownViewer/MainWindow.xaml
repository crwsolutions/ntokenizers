<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NTokenizers_Tools_MarkdownViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NTokenizers_Tools_MarkdownViewer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MarkdownViewer"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="No file open">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                <Button x:Name="BtnExplorer" Content="&#x1F4C2;" ToolTipService.ToolTip="Open in File Explorer"
                        Width="40" Height="30" IsEnabled="False"
                        Click="BtnExplorer_Click" />
                <Button x:Name="BtnOpen" Content="&#x1F4C1;" ToolTipService.ToolTip="Open Markdown file"
                        Width="40" Height="30"
                        Click="BtnOpen_Click" />
                <Button x:Name="BtnEditor" Content="&#x270F;&#xFE0F;" ToolTipService.ToolTip="Open in system editor"
                        Width="40" Height="30" IsEnabled="False"
                        Click="BtnEditor_Click" />
                <Button x:Name="BtnRefresh" Content="&#x1F504;" ToolTipService.ToolTip="Refresh (F5)"
                        Width="40" Height="30" IsEnabled="False"
                        Click="BtnRefresh_Click" />
                <TextBlock x:Name="LblEncoding" Text="—" Margin="8,0,0,0" FontSize="13"
                           VerticalAlignment="Center" />
            </StackPanel>
        </TitleBar>

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
